{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "plugins": ["@prettier/plugin-xml"],
  "overrides": [
    {
      "files": ["*.md", "**/*.md"],
      "options": {
        "parser": "markdown",
        "proseWrap": "preserve"
      }
    },
    {
      "files": ["*.drawio", "**/*.drawio", "*.xml", "**/*.xml"],
      "options": {
        "parser": "xml",
        "xmlWhitespaceSensitivity": "ignore",
        "xmlSelfClosingSpace": true,
        "printWidth": 120
      }
    }
  ]
}
