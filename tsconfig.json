{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@shared": ["./shared/index"]
    }
  },
  "include": ["shared/**/*"]
}
